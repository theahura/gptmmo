{
  "name": "@gptmmo/gptmmo-server",
  "version": "1.0.0",
  "scripts": {
    "start": "lerna run local:start --stream --scope @gptmmo/gptmmo-server",
    "build": "lerna run local:build --stream --scope @gptmmo/gptmmo-server",
    "test": "lerna run local:test --stream --scope @gptmmo/gptmmo-server",
    "local:start": "NODE_ENV=development rollup -c --watch",
    "local:build": "NODE_ENV=production rollup -c",
    "local:test": "jest --forceExit",
    "lint": "concurrently npm:lint:*",
    "lint:deadcode": "ts-prune -e | (! grep -v 'used in module')",
    "lint:depcheck": "depcheck",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:prettier": "prettier . --check",
    "format": "npm run format:eslint && npm run format:prettier",
    "format:prettier": "prettier . --write",
    "format:eslint": "eslint . --fix"
  },
  "dependencies": {
    "@gptmmo/ts-extensions": "*",
    "@gptmmo/persistence": "*",
    "@gptmmo/server-runtime": "*",
    "@gptmmo/status": "*",
    "@inquirer/prompts": "5.5.0",
    "together-ai": "0.6.0-alpha.4"
  },
  "devDependencies": {
    "@babel/core": "7.22.0",
    "@babel/plugin-transform-runtime": "7.21.0",
    "@babel/preset-env": "7.22.0",
    "@babel/runtime": "7.21.0",
    "@rollup/plugin-run": "3.0.1",
    "@rollup/plugin-typescript": "9.0.2",
    "@rollup/plugin-node-resolve": "15.0.2",
    "@gptmmo/style": "*",
    "@gptmmo/tsconfig": "*",
    "@gptmmo/rollup-fail-on-warning": "*",
    "@gptmmo/rollup-plugin-generate-package-json": "*",
    "@types/events": "3.0.0",
    "@types/humanize-duration": "3.27.4",
    "@types/jest": "29.5.11",
    "@types/jsdom": "20.0.1",
    "@types/lodash": "4.14.180",
    "@types/node": "22.2.0",
    "babel-jest": "29.7.0",
    "babel-plugin-transform-import-meta": "2.2.0",
    "concurrently": "7.6.0",
    "depcheck": "1.4.7",
    "eslint": "8.35.0",
    "jest": "29.7.0",
    "prettier": "2.8.4",
    "rollup": "3.26.2",
    "rollup-plugin-copy": "3.4.0",
    "rollup-plugin-dts": "5.3.0",
    "ts-jest": "29.1.1",
    "ts-prune": "0.10.3",
    "typescript": "4.7.2"
  }
}
