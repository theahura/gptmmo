{
  "name": "@gptmmo/server-runtime",
  "version": "1.0.0",
  "license": "ISC",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "start": "lerna run local:start --stream --scope @gptmmo/server-runtime",
    "build": "lerna run local:build --stream --scope @gptmmo/server-runtime",
    "local:start": "NODE_ENV=development rollup -c --watch",
    "local:build": "NODE_ENV=production rollup -c",
    "lint": "concurrently npm:lint:*",
    "lint:deadcode": "ts-prune -e | (! grep -v 'used in module')",
    "lint:depcheck": "depcheck",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:prettier": "prettier . --check",
    "format": "npm run format:eslint && npm run format:prettier",
    "format:prettier": "prettier . --write",
    "format:eslint": "eslint . --fix"
  },
  "dependencies": {
    "@gptmmo/collections": "*",
    "@gptmmo/status": "*",
    "@gptmmo/lib": "*",
    "@gptmmo/persistence": "*",
    "@gptmmo/server-environment": "*",
    "@gptmmo/validation": "*",
    "ajv-formats": "2.1.1",
    "ajv-keywords": "5.1.0",
    "tslib": "2.5.0"
  },
  "devDependencies": {
    "@gptmmo/style": "*",
    "@gptmmo/tsconfig": "*",
    "@gptmmo/rollup-fail-on-warning": "*",
    "@rollup/plugin-typescript": "9.0.2",
    "concurrently": "7.6.0",
    "depcheck": "1.4.3",
    "eslint": "8.35.0",
    "prettier": "2.8.4",
    "rollup": "3.26.2",
    "rollup-plugin-copy": "3.4.0",
    "rollup-plugin-dts": "5.3.0",
    "ts-prune": "0.10.3",
    "typescript": "4.7.2"
  }
}
